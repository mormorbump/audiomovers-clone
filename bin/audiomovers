#!/bin/bash
# audiomovers - MusicMovers + Cloudflare Tunnel グローバルコマンド

set -e

# このスクリプトのシンボリックリンクを辿って実際のパスを取得
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_DIR"

echo "Starting MusicMovers..."
npm run start &
APP_PID=$!
sleep 2

echo "Starting Cloudflare Tunnel..."
docker compose up -d

# URL取得
sleep 5
"$PROJECT_DIR/scripts/get-tunnel-url.sh"

# 終了処理
trap "docker compose down; kill $APP_PID 2>/dev/null" EXIT INT TERM

echo ""
echo "Press Ctrl+C to stop"
wait $APP_PID
